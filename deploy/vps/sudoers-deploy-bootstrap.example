# One-time sudoers for the deploy user (copy to VPS as root).
#
#   sudo cp deploy/vps/sudoers-deploy-bootstrap.example /etc/sudoers.d/deploy-motake
#   sudo chmod 440 /etc/sudoers.d/deploy-motake
#   sudo visudo -c
#
# Required before the first GitHub Actions deploy on a fresh VPS.
# deploy/ci/ensure-production.sh can also create this file automatically
# when passwordless sudo is already available.

Defaults:deploy env_keep += "DEBIAN_FRONTEND"
deploy ALL=(ALL) NOPASSWD: SETENV: /usr/bin/apt-get, /usr/bin/apt, /usr/bin/systemctl, /bin/systemctl, /usr/bin/caddy, /bin/cp, /usr/bin/cp, /bin/mkdir, /usr/bin/mkdir, /bin/chown, /usr/bin/chown, /bin/chmod, /usr/bin/chmod, /usr/bin/corepack, /usr/bin/gpg, /usr/bin/tee, /usr/sbin/ufw, /usr/bin/env, /usr/bin/bash, /bin/bash, /usr/bin/true, /bin/true
