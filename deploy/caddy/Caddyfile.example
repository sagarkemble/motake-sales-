# Motake Caddy fragment — run deploy/vps/caddy-setup.sh to generate deploy/generated/motake.caddy
#
# Production: copied to /etc/caddy/sites/motake.caddy
# The script appends "import sites/motake.caddy" to /etc/caddy/Caddyfile
# only if it is not already present. Existing domains are never removed.

# motake — managed by caddy-setup.sh
# motake-domains: app.example.com api.example.com

app.example.com {
	encode gzip zstd
	reverse_proxy localhost:3000
}

api.example.com {
	encode gzip zstd

	# Meta WhatsApp webhook -> notification container (127.0.0.1:8100). Its tRPC and Inngest
	# paths are never proxied.
	handle /webhooks/whatsapp* {
		reverse_proxy localhost:8100
	}

	handle {
		reverse_proxy localhost:8000
	}
}
