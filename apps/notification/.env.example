# apps/notification (apps/notification/src/env.ts) — copy to apps/notification/.env
# Not symlinked to the root .env: these secrets stay out of the main API (Spec K).
# Run on its own: pnpm --filter @repo/notification dev
# Needs DATABASE_URL and LOGGER_LEVEL too (packages/database, packages/logger).

PORT=8100
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev
LOGGER_LEVEL=debug

# Shared with the main API (NOTIFICATION_INTERNAL_API_KEY in the root .env)
NOTIFICATION_INTERNAL_API_KEY=at-least-32-characters-shared-with-the-main-api

# Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=your-phone-number-id
# The access token is never in this file (Spec J-0). The master copy is a Supabase Vault secret in
# the DATABASE_URL database; the app keeps a working copy in WHATSAPP_TOKEN_FILE (written by the app,
# mode 600) and refills it from Vault. Create the token as a permanent System User token with
# business_management, whatsapp_business_messaging and whatsapp_business_management, then paste it
# in Admin Settings -> WhatsApp access token (steps: deployment.md section 9.1a).
WHATSAPP_TOKEN_FILE=./.secrets/whatsapp-access-token
WHATSAPP_TOKEN_VAULT_SECRET_NAME=motake_whatsapp_access_token
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=any-long-random-string

# Inngest (the SDK runs in cloud mode, so locally use the self-hosted server with the same keys:
#   npx inngest-cli@1.46.0 start --event-key <INNGEST_EVENT_KEY> --signing-key <INNGEST_SIGNING_KEY> \
#     --sdk-url http://127.0.0.1:8100/api/inngest)
INNGEST_EVENT_KEY=local-event-key
# Hex with an even length: openssl rand -hex 32
INNGEST_SIGNING_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
INNGEST_BASE_URL=http://127.0.0.1:8288

# Private Documents bucket (Spec L) — read-only key for this bucket only
NOTIFICATION_R2_ACCOUNT_ID=your-r2-account-id
NOTIFICATION_R2_ACCESS_KEY_ID=your-read-only-key-id
NOTIFICATION_R2_SECRET_ACCESS_KEY=your-read-only-secret
R2_DOCUMENTS_BUCKET_NAME=your-documents-bucket
