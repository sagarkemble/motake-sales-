{
  "name": "trpc-monorepo-template",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo build",
    "dev": "dotenv -- turbo dev",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "lint": "turbo run lint",
    "test": "turbo test",
    "test:local": "bash scripts/test-local.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "loadtest": "dotenv -- bash k6/run.sh",
    "seed:k6-users": "dotenv -- node scripts/seed-k6-users.mjs",
    "tokens:k6": "dotenv -- node scripts/fetch-k6-tokens.mjs",
    "cleanup:k6": "dotenv -- node scripts/cleanup-k6-data.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
