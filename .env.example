# =============================================================================
# Motake monorepo — single source of env vars (root .env)
# Copy to .env via: ./deploy/local/env-setup.sh
# Symlinked into apps/* and packages/* by deploy/local/env-setup.sh
# =============================================================================

# --- apps/api (apps/api/src/env.ts) ---
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000

# --- packages/database (packages/database/env.ts) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# --- packages/logger (packages/logger/env.ts) ---
LOGGER_LEVEL=debug

# --- packages/services (packages/services/env.ts) ---
JWT_SECRET=dev-jwt-secret-change-in-production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Required for POST /api/auth/login (server-side password grant)
SUPABASE_ANON_KEY=your-supabase-anon-key
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://your-r2-public-base-url
# Private bucket for Bill, Note and Payment receipt PDFs: no public access, no public URL.
# The R2 token above must be allowed on this bucket too.
R2_DOCUMENTS_BUCKET_NAME=your-r2-documents-bucket-name

# --- apps/web (apps/web/env.js + apps/web/lib/env.ts) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- notification service client (Spec K / J-0; packages/services/env.ts, optional) ---
# The notification app keeps its own secrets in apps/notification/.env
# (see apps/notification/.env.example); run it with: pnpm --filter @repo/notification dev
# Unset, the main API cannot ask about the WhatsApp token: no Admin banner shows and Send waiting is refused.
# NOTIFICATION_URL=http://127.0.0.1:8100
# NOTIFICATION_INTERNAL_API_KEY=at-least-32-characters-shared-with-the-notification-app
# The Fix access token dialog (from the Admin banner) checks a pasted token against this phone number id
# (same value as the notification app). The token itself is never an env value: it lives in
# Supabase Vault under WHATSAPP_TOKEN_VAULT_SECRET_NAME (same value on both apps).
# META_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_TOKEN_VAULT_SECRET_NAME=motake_whatsapp_access_token

# --- production only (cross-subdomain CORS) ---
# CORS_ALLOWED_ORIGIN=https://sales.motakedairy.com

# --- k6 load tests + seed scripts (optional — see k6/README.md) ---
SEED_API_BASE_URL=https://sales-api.motakedairy.com
K6_API_BASE_URL=https://sales-api.motakedairy.com
# K6_SALESMAN_VUS=10
# K6_ADMIN_VUS=2
# K6_USERS_FILE=k6/data/users.json
